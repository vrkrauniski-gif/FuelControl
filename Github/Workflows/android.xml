name: Gerar APK Android

on:
  workflow_dispatch:
  push:
    branches:
      - main

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Baixar projeto
        uses: actions/checkout@v4

      - name: Instalar .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '9.0.x'

      - name: Instalar MAUI Android
        run: dotnet workload install maui-android

      - name: Gerar APK
        run: dotnet publish FuelControl.csproj -f net9.0-android -c Release -p:AndroidPackageFormat=apk

      - name: Salvar APK
        uses: actions/upload-artifact@v4
        with:
          name: FuelControl-APK
          path: bin/Release/net9.0-android/publish/*.apk
